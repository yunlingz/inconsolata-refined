{
  "name": "inconsolata-refined",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "description": "Four original Inconsolata faces with enlarged narrow proportions, Cascadia Code stroke weights, and fresh ttfautohint hints.",
  "license": "OFL-1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs && node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "node scripts/verify.mjs && node scripts/verify-web.mjs && node scripts/audit.mjs",
    "test:web": "node scripts/verify-web.mjs",
    "preview": "node scripts/preview.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "calibrate:hinting": "node scripts/calibrate-hinting.mjs",
    "audit": "node scripts/audit.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:raster": "node scripts/check-raster.mjs",
    "test:size": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "fontkit": "2.0.4",
    "pngjs": "7.0.0",
    "ttf2woff": "3.0.0",
    "wawoff2": "2.0.1"
  }
}
