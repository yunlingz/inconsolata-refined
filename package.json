{
  "name": "inconsolata-refined",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Four original Inconsolata faces calibrated against installed Iosevka and freshly hinted with ttfautohint.",
  "license": "OFL-1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "node scripts/build.mjs && node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "test": "node scripts/verify.mjs && node scripts/verify-web.mjs && node scripts/audit.mjs",
    "test:web": "node scripts/verify-web.mjs",
    "preview": "node scripts/preview.mjs",
    "calibrate": "node scripts/calibrate.mjs",
    "audit": "node scripts/audit.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:raster": "node scripts/check-raster.mjs"
  },
  "devDependencies": {
    "fontkit": "2.0.4",
    "pngjs": "7.0.0",
    "ttf2woff": "3.0.0",
    "wawoff2": "2.0.1"
  }
}
